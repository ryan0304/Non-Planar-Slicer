; Voron Trident continuous non-planar G-code
; nozzle=0.4 line_width=0.45 layer_height=0.3
; max_z_velocity=25.0 mm/s (feedrate clamped to honour this)

PRINT_START EXTRUDER=210 BED=60 MATERIAL=PLA
M83            ; relative extrusion
G92 E0
M107           ; fan off for first layer(s)

G1 X100.0000 Y100.0000 Z0.2000 F12000  ; travel
G1 X105.0000 Y100.0000 Z0.2000 E0.21000 F1200
G1 X105.0000 Y105.0000 Z0.2000 E0.21000 F1200
G1 X100.0000 Y105.0000 Z0.2000 E0.21000 F1200
G1 X100.0000 Y100.0000 Z0.2000 E0.21000 F1200
G1 E-0.6000 F3600
G1 X101.0000 Y101.0000 Z0.2000 F12000  ; travel
G1 E0.6000 F2400
G1 X104.0000 Y101.0000 Z0.2000 E0.15000 F1200
G1 X101.0000 Y104.0000 Z0.2000 E0.15000 F1200
G1 X104.0000 Y104.0000 Z0.2000 E0.15000 F1200
G1 E-0.6000 F3600

PRINT_END
; total filament: 1.3 mm
