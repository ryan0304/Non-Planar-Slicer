__pycache__/
*.pyc
*.gcode
!examples/*.gcode
!regression_ref/*.gcode
# Test fixtures are source, not output: tools/check_regression.py,
# test_orca_gcode_parser.py and test_mesh_hybrid.py all read these, so without
# this exception a fresh clone gets a test suite that fails on a missing
# fixture rather than a real regression.
!tools/fixtures/**/*.gcode
.venv/
venv/
.DS_Store
custom_printers/

# OrcaSlicer drops a numbered log into the process working directory when a
# slice fails validation (e.g. "00000.log"). It is the subprocess's scratch
# output, not ours, and it appears in `git status` right after any failed
# hybrid generate.
[0-9][0-9][0-9][0-9][0-9].log
